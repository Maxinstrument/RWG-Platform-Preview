rules_version = '2';
// RWG Platform — Firestore security rules
// Paste these into: Firebase Console → Firestore Database → Rules → Publish.
//
// ── The one idea in this file ───────────────────────────────────────
// A rule is the only thing standing between the client book and the
// open internet. The app is not: it draws what it chooses to draw, and
// anyone holding a token can skip it entirely and talk to the API.
//
// So every collection below asks isActive() — "an approved member of
// the firm, still here" — and not signedIn(), which asks only whether
// Firebase has heard of you. Until 22 Aug '26 the data collections
// asked the second question. Sign-up was open, so an account made on
// the login page one minute ago (status 'pending', shown a waiting
// screen by the app, and still holding a perfectly good token) could
// read every household, case and note, and write to most of them.
//
// One place still asks signedIn(), and it is the bootstrap: a brand new
// account must be able to CREATE its own pending user document, and to
// READ that one document back to be told it is waiting. It can reach
// nothing else. See match /users below.
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase has heard of them. That is ALL this means, and on its own
    // it is not a permission — see the note at the top of the file.
    function signedIn() { return request.auth != null; }

    // Approved and still here. A self-created account sits at status
    // 'pending' until a partner lets it in, and a removed one keeps its
    // token until it expires. This is what "the team" means, everywhere.
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // A partner who is still here. Status is checked as well as role
    // (22 Aug '26) so removing a partner actually removes their reach —
    // a token outlives the click that revoked it, and role alone would
    // have kept letting them purge the Trash until it expired.
    function isAdmin() {
      return isActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The owner account is allowed to bootstrap itself as an active admin on first login.
    function isOwnerEmail() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() == 'temperan.carlos@gmail.com';
    }

    match /users/{uid} {
      // Two different reads, and they are not the same permission.
      //
      // Your OWN document, always: a new account has to fetch the record
      // it just created to learn that it is pending, and the app does
      // exactly that — a direct get of users/<my uid>, never a query.
      //
      // The ROSTER — everybody's names and roles — only once approved.
      // Every "who is on this?" list in the app needs it, and a firm of
      // five does not keep its own names from itself; but it is a list of
      // the staff, and somebody who signed up this morning is not staff.
      // Firestore evaluates a query against the rule as a whole, so this
      // OR resolves the way it should: an active user's collection
      // listener passes on isActive(), while a pending account can still
      // get its own document by id and can list nothing at all.
      allow read: if signedIn() && (request.auth.uid == uid || isActive());
      // First-login self-create: agents start pending; the owner email may create itself as active admin.
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'agent' && request.resource.data.status == 'pending')
        || (isOwnerEmail() && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
      );
      // Only the owner/admin can approve, deny, or change roles.
      allow update, delete: if isAdmin();
    }

    match /leads/{id} {
      allow read:   if isActive() && (isAdmin() || resource.data.assignedTo == request.auth.uid);
      allow create: if isActive() && (isAdmin() || request.resource.data.assignedTo == request.auth.uid);
      allow update: if isActive() && (isAdmin() || resource.data.assignedTo == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Deletion archive — a behind-the-scenes copy of every deleted lead, admins only.
    match /deleted_leads/{id} {
      allow read, create, delete: if isAdmin();
    }

    // Frozen weekly performance reports — admins only.
    match /reports/{id} {
      allow read, write: if isAdmin();
    }

    // ── Task categories: the one config doc the team may ADD to ──
    // Carlos, Aug '26: "let anyone create a Category in case there is one I
    // missed but the team finds valuable." The person who notices a word is
    // missing is the person filing the task, and Settings is a partner-only
    // screen — so the plus beside the task window's Category box writes here.
    //
    // Adding only, and hasAll() is the whole guarantee: the list that arrives
    // must still contain every word the list already on the server had. So
    // nobody can rename, reorder away or delete somebody else's category on
    // the way past, and two people adding in the same second ends with the
    // second write REFUSED rather than quietly dropping the first person's
    // word. One new word per write, and a ceiling on the list so a runaway
    // loop cannot inflate the document.
    //
    // Create is here because until a partner opens Settings this doc does not
    // exist at all — the app seeds it with the whole current list (the code
    // defaults) plus the new word, never with the new word alone.
    //
    // The generic config/{doc} block below is untouched and still gives
    // admins unrestricted write, here and everywhere else: matching rules are
    // OR'ed, so this block only ever ADDS permission. Deleting the doc, and
    // every kind of edit that is not an append, remain a partner's.
    match /config/taskcategories {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.value is list
        && request.resource.data.value.size() <= 60
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if isActive()
        && request.resource.data.value is list
        && request.resource.data.value.hasAll(resource.data.value)
        && request.resource.data.value.size() <= resource.data.value.size() + 1
        && request.resource.data.value.size() <= 60
        && request.resource.data.updatedBy == request.auth.uid;
    }

    match /config/{doc} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── Scorecard: opportunities ────────────────────────────────
    // Team-readable (client names visible to all, matching today's Team Cases).
    //
    // Anyone signed in may work any opportunity (2026-08-20). Two people are
    // often on the same file, and an agent who could not move a colleague's
    // case simply stopped using the board. Ownership says whose scorecard a
    // case counts on; it is not a lock.
    //
    // What is guarded is the NUMBERS, and it is guarded here rather than in
    // the UI because this is the half an agent cannot get around: openedWeek
    // never moves, submittedAt is written once, and only a partner may ever
    // write closedAt. Every week's totals stay permanent, and a close stays
    // a partner's confirmation. Admins can still correct a case.
    match /cases/{id} {
      allow read:   if isActive();
      allow create: if isActive();
      allow update: if isActive() && (
        isAdmin() || (
          request.resource.data.get('openedWeek', '') == resource.data.get('openedWeek', '')
          && (resource.data.get('submittedAt', null) == null
              || request.resource.data.get('submittedAt', null) == resource.data.get('submittedAt', null))
          && request.resource.data.get('closedAt', null) == resource.data.get('closedAt', null)
        )
      );
      allow delete: if isAdmin();
    }

    // ── Tasks (phase 3) ─────────────────────────────────────────
    // Team-wide: anyone can create a task for anyone, complete it, or
    // reassign it — visibility is open by decision, and Kathy manages
    // every case's tasks. Delete stays admin (done is the normal end).
    match /tasks/{id} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }

    // ── Money attribution: credit splits (phase 2) ──────────────
    // Partner-only by decision. Rules are per-document, which is exactly
    // why the percentages live in their own collection instead of on the
    // team-readable case.
    match /splits/{caseId} {
      allow read, write: if isAdmin();
    }

    // ── Spine: households + contacts (the Resilient CRM book) ──
    // Open visibility by decision (2026-08-12): the whole team sees
    // and maintains every household and person — NDAs cover it, and
    // per-person money never lives on these documents. Split
    // percentages will get their OWN collection with a partner-only
    // rule in phase 2, precisely because rules are per-document.
    match /households/{id} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }
    match /contacts/{id} {
      allow read, create, update: if isActive();
      allow delete: if isAdmin();
    }

    // ── Notes: the team's own words ─────────────────────────────
    // Anyone signed in can post and read. Nobody edits somebody else's
    // words — an update is a statement of what happened, and a record
    // that can be quietly rewritten is worth less than no record.
    // Removing one goes through the Trash, so the author or a partner
    // may delete, and a partner can always put it back.
    match /notes/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isActive() && (isAdmin() || resource.data.authorUid == request.auth.uid);
    }

    // ── Trash: deleted records, waiting on a partner ────────────
    // Anyone who is allowed to delete a record must also be allowed to
    // file its copy here, or the delete would succeed with nothing kept.
    // Reading, restoring and purging are partners only: this bin holds
    // whole households and closed cases, so it is the most sensitive
    // collection in the database.
    //
    // The delete-half of a restore is an admin action, and the create
    // is guarded to a snapshot of a real record.
    match /trash/{id} {
      allow read, delete: if isAdmin();
      allow create: if isActive()
        && request.resource.data.coll is string
        && request.resource.data.originalId is string
        && request.resource.data.deletedBy == request.auth.uid;
      allow update: if isAdmin();
    }

    // ── Scorecard: weekly submissions ───────────────────────────
    // Aggregate production, team-readable. Doc id is agentUid_weekEnding, so an
    // agent may only write a doc whose agentUid is their own account.
    match /weeks/{id} {
      allow read:   if isActive();
      allow create, update: if isActive() && (
        isAdmin() || request.resource.data.agentUid == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── Library: the weekly brief and the training manuals ──────
    // Carlos, 22 Aug '26: the Sunday brief and the agent courses, where
    // the team already is, and "behind login pages because I don't want
    // just anyone having access to it."
    //
    // Which is the whole reason these documents live HERE and not in the
    // repository beside guide.html: GitHub Pages serves files to anyone
    // who asks and has no idea what a login is. A rule does.
    //
    // Split in two because they are read at different moments. `library`
    // is the catalogue — a title, a date, a section, a size — a kilobyte
    // for the whole shelf, listed every time the screen opens. The pages
    // themselves run a few hundred kilobytes each and are fetched one at
    // a time, by id, only when somebody opens one.
    //
    // Publishing is a partner's. Reading is the firm's, and stops being
    // the firm's the moment somebody leaves — which an emailed
    // attachment or a public URL could never do.
    match /library/{id} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }
    match /library_docs/{id} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    // ── The partners' shelf ─────────────────────────────────────
    // The EOS weekly pack: the numbers by person, who did not file, which
    // cases are stalled and whose desk they sit on. Management's read of
    // the week, not the firm's — so isAdmin() to READ, not only to write.
    //
    // It is a SEPARATE PAIR of collections rather than a flag on a row in
    // `library`, and that is not tidiness. Firestore refuses a list query
    // outright if any document it could return fails the rule, and the
    // Library fetches its whole catalogue in one query when the screen
    // opens. Partner-only rows sitting in `library` would therefore not be
    // hidden from an agent — they would break the Library for every agent.
    // Kept apart, an agent's query never touches a document it cannot have.
    //
    // Client names still never go here. The shelf is narrower, the rule
    // that keeps client information out of the Library is not.
    match /library_eos/{id} {
      allow read, write: if isAdmin();
    }
    match /library_eos_docs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
